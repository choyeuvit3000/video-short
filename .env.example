# Copy to .env (never commit .env). Every key is OPTIONAL - the main pipeline runs without any.

# --- Content sources (official APIs) ---
# Reddit: create a "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=windows:video-short-studio:0.1 (by /u/your_username)
# Threads: long-lived user access token from Meta developer app (threads_basic, threads_keyword_search)
THREADS_ACCESS_TOKEN=

# --- Stock footage (free keys) ---
PEXELS_API_KEY=
PIXABAY_API_KEY=

# --- Paid TTS APIs (disabled in voices/registry.yaml by default) ---
ELEVENLABS_API_KEY=
OPENAI_API_KEY=

# --- Worker nodes (M3.5) ---
# Token shared between controller and the GPU node; generate a long random string
STUDIO_NODE_HOME_GPU_TOKEN=

# --- Tool overrides (optional) ---
# Folder containing ffmpeg.exe / ffprobe.exe if they are not on PATH
STUDIO_FFMPEG_DIR=
